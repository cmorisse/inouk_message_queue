<?xml version='1.0' encoding='utf-8'?>
<openerp>
    <data>
        <record id="module_category_imq" model="ir.module.category">
            <field name="name">Inouk Message Queue</field>
        </record>
    </data>

    <data noupdate="1">
        <record id="group_user" model="res.groups">
            <field name="name">IMQ User</field>
            <field name="implied_ids" eval="[(5, False, False)]" />
            <field name="users" eval="[(6,0,[ref('base.user_root')])]" />
        </record>
    </data>

    <data noupdate="1">
        <record id="group_admin" model="res.groups">
            <field name="name">IMQ Administrators</field>
            <field name="implied_ids" eval="[(6,0,[ref('inouk_message_queue.group_user')])]" />
            <field name="users" eval="[(6,0,[ref('base.user_root')])]" />
        </record>
    </data>

    <data noupdate="1">
        <record id="group_debug" model="res.groups">
            <field name="name">IMQ Debug</field>
            <field name="implied_ids" eval="[(6,0,[])]" />
            <field name="users" eval="[(6,0,[ref('base.user_root')])]" />
        </record>
    </data>
</openerp>