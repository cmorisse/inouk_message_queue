<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="imq_ir_cron__formview" model="ir.ui.view">
        <field name="name">imq.ir_cron.formview.inherit</field>
        <field name="model">ir.cron</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.ir_cron_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="imq_is_worker" />
            </xpath>
            <field name="interval_number" position="attributes">
                <attribute name="invisible">imq_is_worker == True</attribute>
            </field>
            <field name="interval_type" position="attributes">
                <attribute name="invisible">imq_is_worker == True</attribute>
            </field>
            <field name="nextcall" position="attributes">
                <attribute name="force_save">1</attribute>
                <attribute name="readonly">imq_is_worker == True</attribute>
            </field>

            

        </field>
    </record>
    
    <record id="imq_workers_configuration__act_window" model="ir.actions.act_window">
        <field name="name">Workers</field>
        <field name="res_model">ir.cron</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('imq_is_worker','=',True)]</field>
        <field name="context">{'search_default_all': 1}</field>
    </record>
</odoo>