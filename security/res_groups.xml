<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="module_category_imq" model="res.groups.privilege">
            <field name="name">Inouk Message Queue</field>
        </record>
    </data>

    <data noupdate="1">
        <record id="group_user" model="res.groups">
            <field name="name">IMQ User</field>
            <field name="privilege_id" ref="module_category_imq"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="group_admin" model="res.groups">
            <field name="name">IMQ Administrators</field>
            <field name="privilege_id" ref="module_category_imq"/>
            <field name="implied_ids" eval="[(4, ref('inouk_message_queue.group_user'))]"/>
            <field name="users" eval="[(4, ref('inouk_message_queue.user_imq')), (4, ref('base.user_root'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="group_debug" model="res.groups">
            <field name="name">IMQ Debug</field>
            <field name="privilege_id" ref="module_category_imq"/>
        </record>
    </data>
</odoo>
