<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        
        <record id="imq_message_processor__form_view" model="ir.ui.view">
            <field name="name">imq.message_processor.form.view</field>
            <field name="model">imq.message_processor</field>
            <field name="priority" eval="15" />
            <field name="arch" type="xml">
                <form>
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" string="Refresh" icon="fa-refresh" name="refresh" />

                        </div>
                        <div class="oe_title">
                            <h1><field name="name" /></h1>
                        </div>
                        <group>
                            <group>
                                <field name="type" />
                                <field name="selector" required_condition="type != 'rpc'" invisible="type != 'simple'" />

                                <field name="max_attempt" />
                            </group>
                            <group>
                                <field name="module" required="True" />
                                <field name="function" required="True" />
                                <field name="is_method" />
                            </group>
                        </group>

                        <notebook>
                            <page string="Logging">
                                <group>
                                    <group>
                                        <field name="logging_activated" readonly="logging_activated == 'rpc'" />
                                        <field name="capture_log" readonly="logging_activated == False" />
                                    </group>
                                    <group>
                                        <field name="log_level" />
                                        <field name="log_format" />
                                    </group>
                                </group>
                            </page>
                            <page string="Console Output">
                                <group>
                                    <group>
                                        <field name="capture_console" />
                                    </group>
                                    <group>
                                    </group>
                                </group>
                            </page>
                            <page string="SQS Parameters">
                                <group>
                                    <group class="ik_lw210">
                                        <field name="force_visibility_timeout" />
                                        <field name="visibility_timeout" />
                                    </group>
                                    <group>
                                    </group>                                    
                                </group>
                            </page>
                            <page string="Notifications">
                                <group>
                                    <group class="ik_lw250">
                                        <field name="notify_message_processing_start" />
                                        <field name="notify_message_processing_end" />
                                        <field name="notify_message_processing_retry" />
                                        <field name="notify_message_processing_terminate" />
                                        <field name="notify_message_processing_fail" />
                                    </group>
                                    <group>
                                    </group>
                                </group>
                            </page>
                            <page string="Debug" groups="inouk_message_queue.group_debug">
                                <group>
                                    <group>
                                        <field name="id" />
                                    </group>
                                    <group>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="imq_message_processor__tree_view" model="ir.ui.view">
            <field name="name">imq.message_processor.tree.view</field>
            <field name="model">imq.message_processor</field>
            <field name="priority" eval="15" />
            <field name="arch" type="xml">
                <list>
                    <field name="id" optional="hide" />
                    <field name="type" />
                    <field name="name" />
                    
                    <field name="logging_activated" /> 
                    <field name="capture_log" />
                    <field name="log_level" />
                    <field name="log_format" />
                    <field name="is_method" />
                    <field name="force_visibility_timeout" />
                    <field name="visibility_timeout" />
                </list>
            </field>
        </record>

        <record id="imq_message_processor__act_window" model="ir.actions.act_window">
            <field name="name">Message Processors</field>
            <field name="res_model">imq.message_processor</field>
            <field name="view_mode">list,form</field>
            <field name="help">Manage Message processors</field>
        </record>
    </data>

</odoo>