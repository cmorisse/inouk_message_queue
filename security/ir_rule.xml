<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">
        <!-- Force noupdate=False on existing ir_rules so they get updated -->
        <function name="upsert_externalid" model="ir.model.data">
            <value>inouk_message_queue.ir_rule__imq_message_for_user</value>
            <value>ir.rule</value>
            <function name="search" model="ir.rule">
                <value eval="[('name', '=', 'IMQ - Message for user'), ('model_id', '=', ref('inouk_message_queue.model_imq_message'))]" />
            </function>
            <value eval="False" />
        </function>
        <record id="ir_rule__imq_message_for_user" model="ir.rule">
            <field name="model_id" ref="inouk_message_queue.model_imq_message" />
            <field name="name">IMQ - Message for user</field>
            <field name="perm_create" eval="0" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_unlink" eval="0" />
            <field name="active" eval="1" />
            <field name="domain_force">['|', ('user_id','=',user.id), ('requesting_user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('inouk_message_queue.group_user'))]" />
        </record>

        <function name="delete_externalid" model="ir.model.data">
            <value>inouk_message_queue.ir_rule____imq_message_for_admin</value>
        </function>
        <function name="upsert_externalid" model="ir.model.data">
            <value>inouk_message_queue.ir_rule__imq_message_for_admin</value>
            <value>ir.rule</value>
            <function name="search" model="ir.rule">
                <value eval="[('name', '=', 'IMQ - Message for Admin'), ('model_id', '=', ref('inouk_message_queue.model_imq_message'))]" />
            </function>
            <value eval="False" />
        </function>
        <record id="ir_rule__imq_message_for_admin" model="ir.rule">
            <field name="model_id" ref="inouk_message_queue.model_imq_message" />
            <field name="name">IMQ - Message for Admin</field>
            <field name="perm_create" eval="1" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_unlink" eval="1" />
            <field name="active" eval="1" />
            <field name="groups" eval="[(4, ref('inouk_message_queue.group_admin'))]" />
        </record>
    </data>
</odoo>